# Server bind port (inside the container; expose via `ports:` in compose.yaml).
BACKEND_PORT=8000

# Per-game state file directory (inside the container; backed by the `data` named volume).
STATE_DIR=/data

# Absolute origin of the deployed site. Baked into the static HTML at build time
# for canonical / og:url / og:image / twitter:image. No trailing slash.
SITE_URL=http://localhost:3000
